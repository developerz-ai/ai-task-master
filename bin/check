#!/usr/bin/env bash
# one-command check (typecheck + lint + unit + integration tests) — the repository's own gate. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
bun run typecheck && bun run typecheck:tests && bun run lint && bunx madge@8.0.0 --circular packages/*/src && npm run build -w @developerz.ai/ai-claude-compat && bun run test:node && npm run test:integration -w @developerz.ai/aitm
