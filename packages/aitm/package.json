{
  "name": "@developerz.ai/aitm",
  "version": "0.0.28",
  "description": "Autonomous task orchestrator. Goal in, merged PRs out.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ai-task-master.git",
    "directory": "packages/aitm"
  },
  "homepage": "https://github.com/developerz-ai/ai-task-master/tree/main/packages/aitm#readme",
  "bugs": "https://github.com/developerz-ai/ai-task-master/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "aitm": "./dist/cli/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:node": "node --test --test-timeout=30000 --import tsx \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-timeout=120000 --import tsx \"test/**/*.test.ts\"",
    "debug:start": "bun --inspect-brk scripts/debug-start.ts",
    "debug:merge-pr": "bun --inspect-brk scripts/debug-merge-pr.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.42",
    "@developerz.ai/ai-claude-compat": "0.0.28",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.182",
    "execa": "^9.6.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^10.62.0",
    "undici": "^7.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.7.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
