# .env.example — the environment this repository's own commands read.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# dormant: read by the aitm runtime (src/credentials, env or ~/.aitm.json) for start/resume/merge-pr runs; setup/dev/check (optional)
OPENROUTER_API_KEY=

# dormant: optional GlitchTip/Sentry DSN read by src/observability/error-reporter.ts (generic SENTRY_DSN fallback); the re (optional)
AITM_SENTRY_DSN=

# dormant: remote MCP server declared in .mcp.json for the maintainer agent lane; nothing in setup/dev/check connects to i (optional)
glitchtip=
