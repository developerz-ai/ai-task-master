#!/usr/bin/env bash
# one-command check (typecheck + lint + test) — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
bun run typecheck && bun run typecheck:tests && bun run lint && bunx madge@8.0.0 --circular packages/*/src && bun run test:node
