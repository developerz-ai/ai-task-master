{
  "name": "ai-task-master-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:tests": "bun run --filter '*' typecheck:tests",
    "test": "AITM_INSTANT_SLEEP=1 bun test",
    "test:node": "bun run --filter '*' test:node",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.35",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
