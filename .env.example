# .env.example — the environment this repository's own commands read.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# dormant: read by the aitm runtime (src/credentials, env or ~/.aitm.json) for start/resume/merge-pr runs; setup/dev/check (optional)
OPENROUTER_API_KEY=

# optional: an error-reporting DSN for any Sentry-protocol endpoint, read by src/observability/error-reporter.ts (SENTRY_DSN is the fallback); unset, nothing is reported
AITM_SENTRY_DSN=
